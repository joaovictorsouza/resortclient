# Exemplo (copie para fora do repositório, preencha e rode: source ~/android-signing.env).
# Nunca commite o arquivo preenchido: senhas só por variável de ambiente.
export ANDROID_KEYSTORE="$HOME/Documents/keystore/resort/dev/dev-release.keystore"
export ANDROID_KEY_ALIAS="resort-dev"
# Peça ao shell sem eco; assim a senha não fica no histórico nem em arquivo:
read -rs "ANDROID_KEYSTORE_PASSWORD?Senha da keystore: " ; echo; export ANDROID_KEYSTORE_PASSWORD
read -rs "ANDROID_KEY_PASSWORD?Senha da chave (Enter se for a mesma): " ; echo
export ANDROID_KEY_PASSWORD="${ANDROID_KEY_PASSWORD:-$ANDROID_KEYSTORE_PASSWORD}"
